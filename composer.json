{
    "name": "ubermuda/doctrine-extra",
    "description": "Extra Doctrine types for Symfony projects, starting with a libsodium-encrypted string type",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.0|^4.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^7.3|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ubermuda\\DoctrineExtra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ubermuda\\DoctrineExtra\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
